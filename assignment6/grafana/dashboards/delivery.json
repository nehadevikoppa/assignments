{
  "title": "Delivery Monitoring",
  "uid": "delivery",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Total Deliveries", "datasource": { "type": "prometheus", "uid": "prom" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [ { "refId": "A", "expr": "total_deliveries" } ] },
    { "id": 2, "type": "timeseries", "title": "Pending Deliveries", "datasource": { "type": "prometheus", "uid": "prom" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [ { "refId": "A", "expr": "pending_deliveries" } ] },
    { "id": 3, "type": "timeseries", "title": "On-the-Way Deliveries", "datasource": { "type": "prometheus", "uid": "prom" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [ { "refId": "A", "expr": "on_the_way_deliveries" } ] },
    { "id": 4, "type": "timeseries", "title": "Average Delivery Time", "datasource": { "type": "prometheus", "uid": "prom" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [ { "refId": "A", "expr": "average_delivery_time_sum / average_delivery_time_count" } ] }
  ]
}
